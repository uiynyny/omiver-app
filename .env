# Base URL of the deployed mobile/web app — used to build referral links.
# Change this to your production URL when deploying.
VITE_APP_URL=http://localhost:5173

# API URL — routed through the same-origin proxy in both dev and production.
VITE_API_URL=/api

# Stripe publishable key. Safe to expose, but must be set per environment.
# Use a pk_test_... key here and a pk_live_... key in .env.production.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51RxaG6PPPDsod5TWVm4UZ59pq5VWJeSXWB75IKRa84GK9s4sA7mub6FioxXwtrOlOXzifVC3SVXnygr70S72SEHh00Tadafhi0
